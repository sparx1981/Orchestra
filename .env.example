# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional for Claude integration
ANTHROPIC_API_KEY=

# PERPLEXITY_API_KEY: Optional for Perplexity integration
PERPLEXITY_API_KEY=

# GROK_API_KEY: Optional for X (Grok) integration
GROK_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Required to let users connect Google Drive, Google Calendar, or
# Gmail as Knowledge Base sources. Create an OAuth 2.0 Client ID (Web application type) in
# Google Cloud Console, enable the Drive/Calendar/Gmail APIs, and add this app's domain to
# the OAuth consent screen's authorized origins. Without this set, those source types will
# show a notice instead of the Google sign-in prompt.
VITE_GOOGLE_CLIENT_ID=

# KEYS_ENCRYPTION_SECRET: Enables encryption at rest for user API keys. When set, keys are
# encrypted server-side (AES-256-GCM) before being stored in Firestore and decrypted
# just-in-time for provider calls — the browser only ever holds ciphertext. Use a long
# random string and keep it stable; changing it makes previously saved keys unreadable
# (users would simply re-enter them). Without it, keys are stored in plaintext (legacy).
KEYS_ENCRYPTION_SECRET=

# RESEND_API_KEY: Optional. BriefBridge (client intake, "Enquiries" tab) uses this to send
# a "new lead" email via Resend (https://resend.com) whenever a public intake form is
# submitted. Server-side only — never sent to the browser. Without it, submissions still
# save normally; only the email notification is skipped.
RESEND_API_KEY=

# BRIEFBRIDGE_NOTIFICATION_EMAILS: Comma-separated fallback recipient list for the "new
# lead" email above (e.g. "you@studio.com,team@studio.com"). Each intake form can also set
# its own recipients in Form Settings; this is the server-side default used for the notify
# request either way.
BRIEFBRIDGE_NOTIFICATION_EMAILS=
